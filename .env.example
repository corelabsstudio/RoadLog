# development = 로컬 / production = 공개 서버
APP_ENV=development

# hybrid(기본) = 키 있으면 OpenAI 호출(사용량 과금), 없거나 한도 시 스마트 초안
# free = LLM 호출 완전 차단
# paid = LLM 권장·운영 경고 강화
COST_MODE=hybrid

# 세션용 시크릿 (32자 이상 난수 권장)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string

# CORS 허용 출처 (운영: 실제 도메인만, 여러 개는 쉼표)
# 예: https://roadlog.co.kr
ALLOWED_ORIGINS=*

# OpenAI (정식 런칭 필수 — 없으면 규칙 초안)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Supabase (선택 — 미설정 시 로컬 JSON. 운영은 연결 권장)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 관리자 (소스에 비밀번호를 두지 마세요. 운영에서 반드시 강한 값)
ADMIN_USERNAME=your-admin-id
ADMIN_PASSWORD=use-a-strong-password
ADMIN_EMAIL=admin@example.com

# 결제 링크 (스마트스토어/토스 등. 플레이스홀더면 문의 플로우)
PRO_PAYMENT_URL=
# Pro 연 결제 상품 URL (비우면 PRO_PAYMENT_URL 사용)
PRO_ANNUAL_PAYMENT_URL=
ENTERPRISE_PAYMENT_URL=
# Enterprise 연 결제 (연 890,000 · 2개월 무료). 비우면 ENTERPRISE_PAYMENT_URL 사용
ENTERPRISE_ANNUAL_PAYMENT_URL=

# 결제 없이 /api/billing/upgrade 로 플랜 변경 (운영은 반드시 false)
ALLOW_DEMO_BILLING_UPGRADE=false

# 문의
CONTACT_EMAIL=corelabs.studio@gmail.com
CONTACT_TEL=033-818-2021
CONTACT_HP=010-5583-2021
CONTACT_FORM_URL=

# 사업자 고지 (푸터 — 비우면 해당 줄 숨김)
BUSINESS_NAME=코어랩스
BUSINESS_OWNER=호현수
BUSINESS_REG_NO=705-04-02867
BUSINESS_ADDRESS=강원특별자치도 춘천시 세실로192번길 8-3, 1층 왼쪽 상가(후평동)
MAIL_ORDER_REG_NO=

# Google AdSense (Free 결과 하단, 선택)
ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_SLOT=xxxxxxxxxx

# 손님에게 보내는 메일 (비밀번호 재설정 링크) — modules/mailer.py
# 🛑 Railway 는 바깥으로 나가는 SMTP 포트를 막는 일이 잦다. Resend(HTTPS)가 정본이다.
#    RESEND_API_KEY 가 비어 있으면 «비밀번호 찾기»가 503 으로 막힌다.
RESEND_API_KEY=
MAIL_FROM=로드로그 <noreply@roadlog.co.kr>
MAIL_REPLY_TO=corelabs.studio@gmail.com
# 폴백(SMTP 가 열려 있는 곳에서만)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
